---
/**
 * The document shell – the <html>/<head> half of src/app/[locale]/layout.tsx.
 * Pages arrive here already resolved by site/lib/route.ts: a locale, the
 * merged Next metadata, and the React tree Next would have rendered.
 */
import type { Metadata } from "next";
import type { Locale } from "@/i18n/config";
import { localeHtmlLang } from "@/i18n/config";
import favicon from "@/app/favicon.ico?url";
import iconSvg from "@/app/icon.svg?url";
import appleIcon from "@/app/apple-icon.png?url";
/* The faces the first screen is set in, preloaded. Without this the browser
   found them only after parsing the page CSS – 15–18 font files, 264–315 kB,
   queued behind the stylesheet. Only regular body (Fira 400) and display
   (Charis 400): both need the latin subset on every page (spaces, digits,
   punctuation live there), and a Ukrainian page the cyrillic one too. The
   same source files as fonts.css, so Vite emits one asset for both. */
import firaLatin from "@fontsource/fira-sans/files/fira-sans-latin-400-normal.woff2?url";
import firaCyrillic from "@fontsource/fira-sans/files/fira-sans-cyrillic-400-normal.woff2?url";
import charisLatin from "@fontsource/charis-sil/files/charis-sil-latin-400-normal.woff2?url";
import charisCyrillic from "@fontsource/charis-sil/files/charis-sil-cyrillic-400-normal.woff2?url";
// Imported for its stylesheets: the page itself arrives rendered.
import "../lib/Chrome";
import { metadataTags } from "../lib/metadata";
import { CF_BEACON_SRC, cfBeaconConfig, posthogKey } from "@/lib/analytics";
import "@/app/globals.css";
import "@/app/[locale]/shared.css";
import "../styles/fonts.css";
import "../styles/islands.css";

interface Props {
  locale: Locale;
  metadata: Metadata;
  html: string;
}

const { locale, metadata, html } = Astro.props;
const tags = metadataTags(metadata);
const preloadFonts = locale === "uk" ? [firaLatin, firaCyrillic, charisLatin, charisCyrillic] : [firaLatin, charisLatin];

/**
 * Whether this page needs React in the browser at all.
 *
 * Every page has the header island; many have nothing else – /about, /team,
 * the legal pages, every pending case, the 404. There the header was the only
 * reason the island runtime loaded, and all it hydrates is a burger that flips
 * one attribute. Those pages get site/islands/header.ts instead: the same
 * behaviour in a few hundred bytes, over the markup the server already
 * rendered. Any other island on the page – including one inside a slot –
 * and the page hydrates exactly as before, header included.
 *
 * Read off the rendered page rather than declared per route, so a page that
 * gains an island cannot forget to ask for React.
 */
const HEADER = "components/nasvitlo/Header.tsx";
const hydrates = [...html.matchAll(/<nsv-island data-k="([^"#]*)#/g)].some(
  (m) => m[1] !== HEADER,
);
---

<!doctype html>
<html lang={localeHtmlLang[locale]} class="h-full antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {
      tags.map((t) =>
        t.tag === "title" ? (
          <title>{t.text}</title>
        ) : t.tag === "meta" ? (
          <meta {...t.attrs} />
        ) : (
          <link {...t.attrs} />
        ),
      )
    }
    <link rel="icon" href={favicon} sizes="any" />
    <link rel="icon" href={iconSvg} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={appleIcon} sizes="180x180" />
    {preloadFonts.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
  </head>
  <body class="min-h-full">
    <Fragment set:html={html} />
    {
      /* Dev only: React Fast Refresh expects its preamble before any
         component module runs. Astro installs it only for its own
         `client:*` islands, and these islands are not those. */
      import.meta.env.DEV && (
        <script is:inline type="module">
          import RefreshRuntime from "/@react-refresh";
          RefreshRuntime.injectIntoGlobalHook(window);
          window.$RefreshReg$ = () => {};
          window.$RefreshSig$ = () => (type) => type;
          window.__vite_plugin_react_preamble_installed__ = true;
        </script>
      )
    }
    {
      /* Cloudflare Web Analytics – як у корінному layout Next
         (src/app/[locale]/layout.tsx): лише коли збірка має
         NEXT_PUBLIC_CF_ANALYTICS_TOKEN, який astro.config.mjs вбудовує через
         `define`. is:inline – Astro не повинен бандлити чужий скрипт. */
      cfBeaconConfig && (
        <script is:inline defer src={CF_BEACON_SRC} data-cf-beacon={cfBeaconConfig} />
      )
    }
    {/* Хітмапи PostHog – лише зі збірки з NEXT_PUBLIC_POSTHOG_KEY (lib/analytics.ts). */}
    {posthogKey && <script is:inline defer src="/heatmaps.js" data-key={posthogKey} />}
    {
      hydrates ? (
        <script>
          import "../islands/client.tsx";
        </script>
      ) : (
        <script>
          import "../islands/header.ts";
        </script>
      )
    }
  </body>
</html>
